<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Dialogs.TrimFootersDialog"
        Title="Trim Branding Footers"
        Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,4" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,10">
            <Button Content="Select All" Click="OnSelectAll" />
            <Button Content="Select None" Click="OnSelectNone" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="RowsPanel" Spacing="6" />
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="NoteText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource ThFg2}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="TrimButton" Content="Trim…" Click="OnTrim" IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
