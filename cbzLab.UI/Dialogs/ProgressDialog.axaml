<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:cbzLab.Dialogs"
                x:Class="cbzLab.Dialogs.ProgressDialog"
                DialogWidth="420">

    <StackPanel Margin="20,12,20,20" Spacing="12">
        <TextBlock x:Name="LabelText" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Bar" Minimum="0" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>

</dlg:DialogBase>
