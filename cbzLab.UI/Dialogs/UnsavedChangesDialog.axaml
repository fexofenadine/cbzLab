<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Dialogs.UnsavedChangesDialog"
        Title="Unsaved changes"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="The following files have unsaved changes:" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" MaxHeight="220">
            <ItemsControl x:Name="FilesPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscard" />
            <Button x:Name="SaveAllButton" Content="Save All" Click="OnSaveAll" IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
