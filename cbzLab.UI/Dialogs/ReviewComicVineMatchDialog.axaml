<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:cbzLab.Dialogs"
                x:Class="cbzLab.Dialogs.ReviewComicVineMatchDialog"
                Title="Review ComicVine match"
                DialogWidth="520" DialogHeight="560">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,12,20,20">
        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="RowsPanel" Spacing="12" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="ApplyButton" Content="Apply Checked Fields" Click="OnApply" IsDefault="True" />
        </StackPanel>
    </Grid>

</dlg:DialogBase>
