<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:cbzLab.Dialogs"
                x:Class="cbzLab.Dialogs.FindReplaceDialog"
                Title="Find &amp; Replace"
                DialogWidth="440">

    <Grid RowDefinitions="*,Auto" Margin="20,12,20,20">
      <ScrollViewer Grid.Row="0">
       <StackPanel Spacing="12">
        <TextBlock x:Name="ScopeText" Opacity="0.75" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
            <TextBlock Text="Field" />
            <ComboBox x:Name="FieldCombo" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Find" />
            <TextBox x:Name="FindBox" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Replace with" />
            <TextBox x:Name="ReplaceBox" />
        </StackPanel>

        <CheckBox x:Name="CaseSensitiveCheck" Content="Case sensitive" />
        <CheckBox x:Name="RegexCheck" Content="Regular expression" Click="OnRegexToggled" />
        <TextBlock x:Name="RegexHint" IsVisible="False" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="24,-6,0,0"
                   Text="Find is a .NET regular expression. In Replace with, $1 is the first bracketed group and $0 the whole match." />

        <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />

       </StackPanel>
      </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="ReplaceButton" Content="Replace…" Click="OnReplace" IsDefault="True" />
        </StackPanel>
    </Grid>

</dlg:DialogBase>
