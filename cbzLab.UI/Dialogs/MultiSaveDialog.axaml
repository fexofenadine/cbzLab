<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:cbzLab.Dialogs"
                x:Class="cbzLab.Dialogs.MultiSaveDialog"
                Title="Save files"
                DialogWidth="460" DialogHeight="480">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,12,20,20">
        <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="RowsPanel" Spacing="6" />
        </ScrollViewer>

        <TextBlock x:Name="CbrNote" Grid.Row="2" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,10,0,0"
                    Text="Saving as CBR requires an external RAR tool (see Settings)." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </Grid>

</dlg:DialogBase>
