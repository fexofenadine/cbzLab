<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:cbzLab.Dialogs"
                xmlns:d="using:cbzLab.Dialogs"
                x:Class="cbzLab.Dialogs.MatchIssueDialog"
                Title="Choose an issue"
                DialogWidth="520" DialogHeight="520">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,12,20,20">
        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ListBox Grid.Row="1" x:Name="IssuesList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="d:IssueRow">
                    <StackPanel Margin="4" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Number}" FontSize="13" Opacity="0.8" Width="50" />
                        <TextBlock Text="{Binding Meta}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--wraps onto a second line where the dialog is narrow (a phone), rather than running off its edge-->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,6,-8,0">
            <Button x:Name="ChangeSeriesButton" Content="Change Series…" Click="OnChangeSeries" Margin="0,8,8,0"
                    ToolTip.Tip="This is the wrong series: search ComicVine again and pick another" />
            <Button x:Name="CancelAllButton" Content="Cancel All" Click="OnCancelAll" Margin="0,8,8,0" IsVisible="False"
                    ToolTip.Tip="Stop matching: nothing is applied to any of the selected books" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,8,8,0" />
            <Button x:Name="UseButton" Content="Use Selected Issue" Click="OnUse" IsEnabled="False" Margin="0,8,8,0" />
        </WrapPanel>
    </Grid>

</dlg:DialogBase>
