<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:cbzLab.Dialogs"
                x:Class="cbzLab.Dialogs.AboutDialog"
                DialogWidth="460" FullScreenOnPhone="False" DialogHeight="416"
                Background="#0D0221">

    <!--fixed Synthwave Dark palette always, regardless of the app's active theme (by
        request) - branding chrome, not an editing surface, so it deliberately does not
        use the Th* DynamicResource brushes ThemeService drives-->
    <dlg:DialogBase.Styles>
        <Style Selector="Button.aboutBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#261255" />
            <Setter Property="BorderBrush" Value="#FF2D9B" />
        </Style>
        <Style Selector="Button.aboutBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#261255" />
            <Setter Property="BorderBrush" Value="#FF2D9B" />
        </Style>
        <Style Selector="Button.aboutChip">
            <Setter Property="Background" Value="#BF261255" />
            <Setter Property="BorderBrush" Value="#FF2D9B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F0D6FF" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.aboutChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A1F7A" />
            <Setter Property="BorderBrush" Value="#FF2D9B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.aboutChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#261255" />
            <Setter Property="BorderBrush" Value="#FF2D9B" />
        </Style>
    </dlg:DialogBase.Styles>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ClipToBounds="True">
            <Image x:Name="HeroImage" Stretch="Uniform" Width="320"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" Opacity="0.32" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#CC0D0221" Offset="0" />
                        <GradientStop Color="#330D0221" Offset="0.30" />
                        <GradientStop Color="#660D0221" Offset="0.58" />
                        <GradientStop Color="#F20D0221" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,18" Spacing="4">
                <TextBlock Text="cbzLab" FontSize="24" FontWeight="SemiBold" Foreground="#F0D6FF" />
                <Border Background="#BF261255" BorderBrush="#FF2D9B" BorderThickness="1" CornerRadius="10"
                        Padding="9,2" HorizontalAlignment="Left" Margin="0,2,0,6">
                    <TextBlock x:Name="VersionText" FontSize="11" FontWeight="SemiBold" Foreground="#FF2D9B" />
                </Border>
                <TextBlock Text="ComicInfo.xml metadata editor for CBZ/CBR comic archives." TextWrapping="Wrap"
                           FontSize="12.5" Foreground="#E8D9FF" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Classes="aboutChip" Click="OnOpenWebsite">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!--globe, stroked outline-->
                            <Viewbox Width="13" Height="13">
                                <Path Width="16" Height="16" Stroke="#F0D6FF" StrokeThickness="1.3" StrokeLineCap="Round"
                                      Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M1,8 H15 M8,1 C4.5,4.5 4.5,11.5 8,15 M8,1 C11.5,4.5 11.5,11.5 8,15" />
                            </Viewbox>
                            <TextBlock Text="Website" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="aboutChip" Click="OnOpenGitHub">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!--github mark, filled-->
                            <Viewbox Width="13" Height="13">
                                <Path Width="16" Height="16" Fill="#F0D6FF"
                                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                            </Viewbox>
                            <TextBlock Text="GitHub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="© 2026 fexofenadine · .NET 10 · Avalonia UI" FontSize="11" Foreground="#C49DFF" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#0D0221" BorderBrush="#4A1F7A" BorderThickness="0,1,0,0">
            <Button Classes="aboutBtn" HorizontalAlignment="Right" Margin="20,12" IsDefault="True"
                    Background="#261255" BorderBrush="#4A1F7A" BorderThickness="1" CornerRadius="4"
                    Padding="20,6" Cursor="Hand" Foreground="#F0D6FF" FontSize="13" Content="OK" Click="OnOk" />
        </Border>
    </Grid>
</dlg:DialogBase>
