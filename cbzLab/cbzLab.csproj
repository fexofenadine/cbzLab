<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--winui 3 desktop app, unpackaged (plain exe, no msix) for simple distribution-->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>cbzLab</RootNamespace>
    <AssemblyName>cbzLab</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--run without packaging; carry the windows app sdk runtime alongside the exe-->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!--PublishSingleFile + IncludeNativeLibrariesForSelfExtract: originally tried in
        0.1.3, reverted in 0.1.23 after a launch crash that looked single-file-related
        (native dlls were loading from a %TEMP% self-extraction path). Turned out to be
        a red herring — the identical crash persisted in 0.1.23 with single-file OFF,
        and was only actually fixed by the WindowsAppSDK 1.6 -> 1.8 bump in 0.1.24/25
        (see CHANGELOG). Current Microsoft docs confirm PublishSingleFile is officially
        supported for unpackaged, self-contained WinUI 3 apps since WindowsAppSDK 1.5 —
        cbzLab is both, and is now on 1.8. Re-enabled in 0.1.27. The native WinAppSDK
        files still extract to a temp folder at runtime either way — this collapses the
        managed dependencies into cbzLab.exe, it doesn't change that part.-->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--this app has no localized ui of its own; skip copying satellite resource dlls
        for the dozens of cultures .net/WindowsAppSDK ship by default-->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--exe resource icon-->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!--version, kept in sync with the changelog-->
    <Version>0.1.44</Version>
    <AssemblyVersion>0.1.44.0</AssemblyVersion>
    <FileVersion>0.1.44.0</FileVersion>
    <Authors>fexofenadine</Authors>
    <Product>cbzLab</Product>
    <Description>ComicInfo.xml metadata editor for CBZ/CBR archives</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--bundled data assets, copied next to the exe so first-run seeding can find them-->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--bumped 1.6.250108002 -> 1.8.260529003 in 0.1.24 to chase a launch crash on a
        Windows 11 Dev Channel build far newer than 1.6 was ever tested against (see
        CHANGELOG). Deliberately stayed within the 1.x line rather than jumping to the
        current 2.x stable — 2.0 introduced semantic versioning as a deliberate break
        from 1.x, so that's a bigger, riskier jump to make blind. Escalate to 2.x only
        if this doesn't resolve it.-->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <!--bumped alongside WindowsAppSDK in 0.1.24 -> 0.1.25: 1.8.260529003 transitively
        needs BuildTools >= 10.0.26100.4654, and this project treats package downgrades
        (NU1605) as a build error, so the old 10.0.26100.1742 pin has to move up too-->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!--rar reading (cbr) without external tools; 0.48.0+ required to clear GHSA-6c8g-7p36-r338-->
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <!--grid view (0.1.34): the Microsoft/CommunityToolkit DataGrid has been abandoned
        since 7.1.2 in Nov 2021, and current Microsoft docs say so directly, recommending
        this package by name instead. Actively maintained, purpose-built for WinUI 3,
        derived from ListView (fluent styling + virtualization for free), IsReadOnly at
        both grid and column level out of the box.-->
    <PackageReference Include="WinUI.TableView" Version="1.4.1" />
  </ItemGroup>

</Project>
