<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--a plain tfm with no windows-specific suffix: windows and linux desktop from one build-->
    <!--WinExe, not Exe: plain Exe allocates a console window on Windows (the
        blank/black window that stayed open behind the GUI for the whole
        session), matching a real bug rather than a testing artifact - the
        winui original's own csproj already uses WinExe for the same reason.
        WinExe is a Windows PE-subsystem concept with no meaning on Linux, so
        this stays a no-op there rather than breaking cross-platform builds.-->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>cbzLab</RootNamespace>
    <AssemblyName>cbzLab</AssemblyName>
    <!--Win32 PE resource icon (Explorer/taskbar) - Windows-only concept, harmless no-op on Linux.
        Window/titlebar icon is set separately in code (MainWindow.LoadWindowIcon) since Avalonia
        windows don't inherit this automatically the way WinUI 3 windows do.-->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--2.0.0: parity with the winui original reached, beta tag dropped. This project itself
        was renamed from cbzLab.Avalonia/ to cbzLab/ once the winui original moved to
        cbzLab.winui3/ (see cbzLab.winui3/ARCHIVED.md) - this is now the primary and only
        actively developed version. Since 2.2.0 the Version property below is the only place the version is
        written: the title bar, About box and update check all read it from the built app
        (cbzLab.Core's AppVersion).
        2.0.1: the rename above, plus a verified SharpCompress bump and first-ever
        confirmed macOS publish - also the first release actually cut via release.yml
        rather than by hand.-->
    <Version>3.1.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
  </PropertyGroup>

  <!--scoped to Release only, not the main PropertyGroup above: SelfContained
      (and RID-specific output it implies) applies to plain `dotnet build`
      too, not just `dotnet publish`, if left unconditional - confirmed the
      hard way when a debug build silently started producing bin/Debug/
      net10.0/win-x64/ (a full self-contained framework copy) instead of the
      normal bin/Debug/net10.0/ single-dll output, and a stale pre-existing
      exe at the old path kept getting tested instead of the real new build.
      Every publish command actually used for this project passes -c Release,
      so gating on Configuration keeps `dotnet build`'s
      default Debug config fast and framework-dependent while Release
      publishes still get the single-file bundle below.-->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!--matches cbzLab.winui3/cbzLab.csproj's own publish settings, so `dotnet publish -c
        Release` needs no extra flags on the command line either - the winui
        original already carries the same reasoning in its own (longer)
        comment on these same three properties. IncludeNativeLibrariesForSelfExtract
        bundles Avalonia's native deps (Skia/HarfBuzz/ANGLE) into the single
        exe instead of leaving them as loose DLLs beside it.-->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--the single-file bundle is already extracted-to-disk on first run
        (IncludeNativeLibrariesForSelfExtract implies that), so compressing it
        costs only a one-time decompress on the first launch of each build -
        subsequent launches reuse the extracted cache same as before. Pure
        packaging-level size win, no behaviour change.-->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!--drops the parts of .net and avalonia the app never calls, which halves the download
        (51 MB to about 25). partial: only libraries that declare themselves safe to trim are
        trimmed; cbzLab's own three assemblies are kept whole, so the bindings the views build
        by property name still find their properties.
        A trimmed build has no reflection-based json, so everything stored as json goes through
        generated serialisers (cbzLab.Core's StoreJson) - a stored type missing from that list
        fails to load in a release build only. The tests run with the same restriction.-->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!--IL2104 is "a library produced trim warnings" for avalonia's data grid and its designer
        support, neither of which is this project's code to fix; the grid is checked by hand in
        the published build instead-->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <!--Avalonia.Diagnostics (dev-time f12 inspector) skipped for now: as of
        this writing it has no 12.x release yet (latest is 11.3.20, against
        core packages at 12.1.1) - add back once a compatible version ships-->
    <!--SharpCompress (cbr reading) and SkiaSharp (Trim Footers) come in through cbzLab.Core,
        which is where they're pinned - see the note on SkiaSharp there-->
    <!--Avalonia.Themes.Fluent and Avalonia.Controls.DataGrid come in through cbzLab.UI-->
  </ItemGroup>

  <ItemGroup>
    <!--the shared view, dialogs and styles; it brings cbzLab.Core (services, view models, models) with it-->
    <ProjectReference Include="..\cbzLab.UI\cbzLab.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--test-only hooks stay internal rather than public (cbzLab.Core grants the same for its own)-->
    <InternalsVisibleTo Include="cbzLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--ported schema.json/themes.json/theme files, same seeding pattern as
        cbzLab.winui3/cbzLab.csproj - see cbzLab.Core/Services/SettingsService.cs SeedBundledAssets()-->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--SkiaSharp/HarfBuzzSharp ship their native .pdb files as content-copied
      publish outputs (~105MB combined) alongside their .dll - the .dll
      itself is a "native library" IncludeNativeLibrariesForSelfExtract
      already bundles into the exe above, but its .pdb isn't covered by
      that flag and would otherwise stay loose. cbzLab.pdb (this project's
      own, small) is left alone - matches the winui original, which ships
      exactly one pdb for the same debugging reason.-->
  <Target Name="RemoveThirdPartyNativePdbsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                              Condition="'%(Filename)' == 'libSkiaSharp' or '%(Filename)' == 'libHarfBuzzSharp'" />
    </ItemGroup>
  </Target>

</Project>
