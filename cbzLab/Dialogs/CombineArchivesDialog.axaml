<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Dialogs.CombineArchivesDialog"
        Title="Combine Archives"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="These archives will be joined into one new CBZ, in the order shown. Pages are renumbered into a single sequence; the first book's ComicInfo.xml is kept and the rest are dropped." />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,10">
            <Button Content="Sort A–Z" Click="OnSortAlphabetically"
                    ToolTip.Tip="Restore the default order: alphabetical by filename" />
            <Button Content="Reverse" Click="OnReverse" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="RowsPanel" Spacing="2" />
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="SummaryText" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource ThFg2}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="CombineButton" Content="Combine…" Click="OnCombine" IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
