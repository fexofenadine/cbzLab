<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:cbzLab"
        x:Class="cbzLab.MainWindow"
        Title="cbzLab"
        Width="900" Height="640"
        MinWidth="560" MinHeight="420">

    <!--everything shown lives in the shared MainView (cbzLab.UI); this window only adds what a
        desktop window has: its size and position, icon, title, closing, and updating the app-->
    <ui:MainView x:Name="View" />

</Window>
