<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Avalonia.Dialogs.ReviewComicVineBatchDialog"
        Title="Review ComicVine batch match"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="RowsPanel" Spacing="14" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="ApplyButton" Content="Apply Checked Fields" Click="OnApply" IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
