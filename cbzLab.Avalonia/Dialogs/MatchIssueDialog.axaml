<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:cbzLab.Avalonia.Dialogs"
        x:Class="cbzLab.Avalonia.Dialogs.MatchIssueDialog"
        Title="Choose an issue"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ListBox Grid.Row="1" x:Name="IssuesList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="d:IssueRow">
                    <StackPanel Margin="4" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Number}" FontSize="13" Opacity="0.8" Width="50" />
                        <TextBlock Text="{Binding Meta}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="UseButton" Content="Use Selected Issue" Click="OnUse" IsEnabled="False" />
        </StackPanel>
    </Grid>

</Window>
