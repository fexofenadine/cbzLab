<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Avalonia.Dialogs.MessageDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Button x:Name="OkButton" Content="OK" HorizontalAlignment="Right" Click="OnOk" IsDefault="True" />
    </StackPanel>

</Window>
