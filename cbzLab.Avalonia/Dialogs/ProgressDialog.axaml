<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Avalonia.Dialogs.ProgressDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}"
        Closing="OnClosingIntercept">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="LabelText" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Bar" Minimum="0" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>

</Window>
