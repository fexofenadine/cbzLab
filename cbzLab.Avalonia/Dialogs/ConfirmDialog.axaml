<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Avalonia.Dialogs.ConfirmDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="ConfirmButton" Content="OK" Click="OnConfirm" IsDefault="True" />
        </StackPanel>
    </StackPanel>

</Window>
