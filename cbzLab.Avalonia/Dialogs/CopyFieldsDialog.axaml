<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Avalonia.Dialogs.CopyFieldsDialog"
        Title="Copy Fields to Selection"
        Width="480" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" MaxHeight="320">
            <StackPanel x:Name="ChecksPanel" Spacing="4" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="This overwrites the target files' current values for every field checked above. Number and Page Count start unchecked since they're usually issue-specific." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            <Button x:Name="CopyButton" Content="Copy" Click="OnCopy" IsDefault="True" />
        </StackPanel>
    </Grid>

</Window>
