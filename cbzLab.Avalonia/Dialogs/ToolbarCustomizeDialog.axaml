<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="cbzLab.Avalonia.Dialogs.ToolbarCustomizeDialog"
        Title="Customize Toolbar"
        Width="380" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThBg}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                    Text="Check the buttons you want on the toolbar, and use the arrows to reorder them." />

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="RowsPanel" Spacing="2" />
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" x:Name="ResetButton" Content="Reset to Default" Click="OnResetToDefault" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
                <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
