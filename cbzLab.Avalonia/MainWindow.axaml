<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:cbzLab.ViewModels"
        x:Class="cbzLab.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="cbzLab 2.0.0 Beta 1.0"
        Width="900" Height="640">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto"
          Background="{DynamicResource ThBg}"
          DragDrop.AllowDrop="True"
          DragDrop.DragOver="OnDragOver" DragDrop.DragEnter="OnDragEnter"
          DragDrop.DragLeave="OnDragLeave" DragDrop.Drop="OnDrop"
          KeyDown="OnRootGridKeyDown">

        <!--menu bar (slice 4): scoped to items that wire to functionality
            already built in earlier slices, plus About - see plan for the
            full list of deferred items (Theme submenu, Save As/All,
            Revert/Remove/Close, keyboard accelerators)-->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Open…" Click="OnOpen" HotKey="Ctrl+O" />
                <!--slice 12: items populated/cleared via RecentMenu.Items in
                    code (BuildRecentMenu), same pattern as RebuildGridColumns-->
                <MenuItem x:Name="RecentMenu" Header="Open Recent" />
                <Separator />
                <MenuItem Header="Save" Click="OnSave" HotKey="Ctrl+S" />
                <MenuItem Header="Save As…" Click="OnSaveAs" HotKey="Ctrl+Shift+S" />
                <!--slice 19: per-file format picker (MultiSaveAsync) and a
                    cancellable progress dialog for large batches stay deferred -
                    Save All uses each file's existing format, no progress UI-->
                <MenuItem Header="Save All" Click="OnSaveAll" HotKey="Ctrl+Alt+S" />
                <Separator />
                <MenuItem Header="Revert" Click="OnRevert" />
                <MenuItem Header="Remove from List" Click="OnRemove" />
                <MenuItem Header="Close" Click="OnCloseFile" HotKey="Ctrl+W" />
                <MenuItem Header="Close All" Click="OnCloseAll" />
                <Separator />
                <MenuItem Header="Quit" Click="OnQuit" HotKey="Ctrl+Q" />
            </MenuItem>
            <MenuItem Header="_View">
                <!--same one-way + explicit-toggle pattern as GridViewToggle
                    below, and for the same reason: ToggleType="CheckBox"'s
                    IsChecked is bool? and didn't round-trip TwoWay in slice 2-->
                <MenuItem Header="Show All Fields" ToggleType="CheckBox"
                          IsChecked="{Binding ShowAllFields, Mode=OneWay}" Click="OnToggleShowAllFields" />
                <MenuItem Header="Show Extra Fields" ToggleType="CheckBox"
                          IsChecked="{Binding ShowExtraFields, Mode=OneWay}" Click="OnToggleShowExtraFields" />
                <Separator />
                <MenuItem Header="Choose Grid Columns…" Click="OnChooseColumns" />
                <Separator />
                <!--theme slice: populated/cleared via ThemeMenu.Items in code
                    (BuildThemeMenu), same pattern as RecentMenu/RebuildGridColumns-->
                <MenuItem x:Name="ThemeMenu" Header="Theme" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Search ComicVine…" Click="OnSearchComicVine"
                          IsVisible="{Binding OnlineLookupEnabled}" />
                <Separator IsVisible="{Binding OnlineLookupEnabled}" />
                <!--slice 15: Guess from Filename/Auto Page Count/Copy/Paste XML-->
                <MenuItem Header="Guess from Filename" Click="OnGuessFromFilename" />
                <MenuItem Header="Auto Page Count" Click="OnAutoPageCount" />
                <Separator />
                <MenuItem Header="Copy ComicInfo.xml" Click="OnCopyXml" />
                <MenuItem Header="Paste ComicInfo.xml" Click="OnPasteXml" />
                <Separator />
                <MenuItem Header="Settings…" Click="OnSettings" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About cbzLab" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!--toolbar (slice 23): matches the winui original's full button set -
            previously missing Copy/Paste XML, Guess from Filename, Search
            ComicVine, and the All Fields/Extra Fields toggles, all reachable
            only via the Tools/View menus until now. Real overflow was
            confirmed against the winui build (left/right scroll arrows,
            "All Fi..." cut off) - Avalonia's toolbar doesn't scroll, so this
            wraps instead; a scroll region is a possible follow-up if the
            window gets narrow enough for that to matter in practice.-->
        <!--buttons are direct children of the WrapPanel (not nested in a
            StackPanel) - a WrapPanel only wraps its own direct children, so
            an inner StackPanel here would just overflow as one giant
            never-wrapping child, which is exactly the bug this replaced:
            buttons ran off the right edge on a narrow window instead of
            wrapping to a second line-->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="12,10">
            <Button x:Name="OpenButton" Content="Open…" Click="OnOpen" />
            <Button x:Name="SaveButton" Content="Save" Click="OnSave" />
            <Button x:Name="SaveAllButton" Click="OnSaveAll" ToolTip.Tip="Save every file with unsaved changes">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Save All" />
                    <!--dirty-count badge (slice 23) - previously missing;
                        HasDirtyFiles/DirtyCount were already fully wired-->
                    <Border Background="{DynamicResource ThBg2}"
                            BorderBrush="{DynamicResource ThDirtyFg}" BorderThickness="1.5"
                            CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                            IsVisible="{Binding HasDirtyFiles}">
                        <TextBlock Text="{Binding DirtyCount}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThDirtyFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Button>
            <Button x:Name="RevertButton" Content="Revert" Click="OnRevert"
                    ToolTip.Tip="Discard edits and reload the current file from disk" />
            <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove"
                    ToolTip.Tip="Remove the selected file(s) from the list (not from disk)" />
            <Button Content="Copy XML" Click="OnCopyXml" />
            <Button Content="Paste XML" Click="OnPasteXml" />
            <Button Content="Guess from Filename" Click="OnGuessFromFilename" />
            <Button Content="Search ComicVine…" Click="OnSearchComicVine"
                    IsVisible="{Binding OnlineLookupEnabled}" />
            <!--IsChecked bound one-way only throughout this toolbar: a TwoWay
                bool?/bool ToggleButton binding didn't round-trip back to the
                viewmodel reliably (visual toggle flipped, the property never
                changed) - flipping it explicitly in each click handler instead-->
            <ToggleButton Content="All Fields" IsChecked="{Binding ShowAllFields, Mode=OneWay}" Click="OnToggleShowAllFields" />
            <ToggleButton Content="Extras" IsChecked="{Binding ShowExtraFields, Mode=OneWay}" Click="OnToggleShowExtraFields" />
            <ToggleButton x:Name="GridViewToggle" Content="Grid View" IsChecked="{Binding IsGridViewActive, Mode=OneWay}" Click="OnToggleGridView" />
            <Button x:Name="ChooseColumnsButton" Content="Choose Columns…" Click="OnChooseColumns" />
        </WrapPanel>

        <!--sidebar+editor: slice 1 view, hidden while the grid view is active-->
        <Grid Grid.Row="2" ColumnDefinitions="260,Auto,*" IsVisible="{Binding !IsGridViewActive}">

            <!--sidebar: open files-->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="OPEN FILES" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.6" Margin="4,8,4,4" />

                <!--filter is a separate, always-live text filter over the file list
                    itself; distinct from the field-search box (SearchBox, in the
                    editor column), which only searches within one open file-->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="4,0,4,6">
                    <TextBox x:Name="FileFilterBox" Width="130" PlaceholderText="Filter files…"
                             Text="{Binding FileFilterText, Mode=TwoWay}" />
                    <ComboBox x:Name="SortCombo" Width="112" SelectedIndex="0"
                              SelectionChanged="SortCombo_SelectionChanged"
                              ToolTip.Tip="Sort open files by">
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Series / No." />
                        <ComboBoxItem Content="Modified" />
                    </ComboBox>
                </StackPanel>

                <!--Ctrl+A/Delete attached to the list itself, not the window, so
                    they don't fight with text selection/deletion in a field-->
                <ListBox x:Name="FileList" Grid.Row="2"
                         ItemsSource="{Binding DisplayedFiles}"
                         SelectionMode="Multiple"
                         Focusable="True"
                         SelectionChanged="FileList_SelectionChanged"
                         KeyDown="OnFileListKeyDown"
                         ContextRequested="OnFileListContextRequested">
                    <ListBox.ContextMenu>
                        <ContextMenu Opening="FileContextMenu_Opening">
                            <MenuItem Header="Save" Click="OnSave" />
                            <MenuItem Header="Revert" Click="OnRevert" />
                            <MenuItem Header="Remove from List" Click="OnRemove" />
                            <Separator />
                            <MenuItem Header="Copy Fields to Rest of Selection" Click="OnCopyFieldsToSelection" />
                            <Separator />
                            <MenuItem Header="Open Containing Folder" Click="OnOpenContainingFolder" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComicFileViewModel">
                            <Grid ColumnDefinitions="30,*"
                                  Margin="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).FileRowMargin}">
                                <Border Grid.Column="0" Width="30" Height="40" CornerRadius="2" Background="{DynamicResource ThBg2}">
                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        <TextBlock Text="&#x2022;" FontWeight="Bold" Foreground="{DynamicResource ThDirtyFg}" IsVisible="{Binding IsDirty}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="{Binding SubtitleOpacity}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--batch selection summary (slice 23) - previously missing entirely;
                    MainViewModel.BatchHeader/BatchFileNames were already fully wired
                    and populated, just never surfaced anywhere in this port-->
                <Border Grid.Row="3" Background="{DynamicResource ThBatchBg}"
                        BorderBrush="{DynamicResource ThSep}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsBatchMode}">
                    <StackPanel Margin="14,8" Spacing="4">
                        <TextBlock Text="{Binding BatchHeader}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThAccent}" />
                        <ScrollViewer MaxHeight="130">
                            <ItemsControl ItemsSource="{Binding BatchFileNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{DynamicResource ThFg}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ThSep}" />

            <!--editor: one shared field list, filtered by ActiveTab-->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">
                <!--cover + filename banner (slice 23) - single-file only, previously
                    missing entirely; matches the winui original's own placement
                    (top of the editor column, above search/tabs/fields)-->
                <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource ThSep}"
                        BorderThickness="0,0,0,1" IsVisible="{Binding IsSingleFileMode}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="84" Height="112" CornerRadius="3" Background="{DynamicResource ThBg2}">
                            <Image Source="{Binding CurrentFile.CoverImage}" Stretch="UniformToFill"
                                   IsVisible="{Binding CurrentFile.HasCover}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFile.FileName}" FontSize="15"
                                       TextTrimming="CharacterEllipsis" MaxWidth="600" />
                            <TextBlock Text="{Binding CurrentFile.Subtitle}" FontSize="12"
                                       Opacity="{Binding CurrentFile.SubtitleOpacity}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="600" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--filters VisibleFields by label/tag text within the currently open
                    file; distinct from FileFilterBox, which filters the sidebar's own
                    file list - disabled in batch mode (IsSearchEnabled), same as the
                    winui original-->
                <TextBox Grid.Row="1" x:Name="SearchBox" Margin="16,10,16,0" PlaceholderText="Search fields…"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         IsEnabled="{Binding IsSearchEnabled}" />

                <!--tab strip (slice 23/24) - moved here from a global row below the
                    toolbar, which was wrong: tabs filter this file's fields and
                    only make sense once a file is selected, matching the winui
                    original's TabView, which lives inside this same editor
                    column. A real TabControl now, not a row of plain Buttons -
                    the buttons had no selected-state styling at all, so there
                    was no visual way to tell which tab was active. Height fixed
                    at 44 (matching the winui TabView's own Height="44") so the
                    control's normally-expanding content-presenter area (empty
                    here - the shared field list below is the real content,
                    same architecture as the winui original) doesn't push the
                    field list down or fight the Grid's own row sizing.-->
                <!--left-aligned, auto-width tabs rather than stretching evenly
                    across the width like the winui original's TabView - tried a
                    UniformGrid ItemsPanel to match that, but with 5 tabs of
                    uneven label length ("Basic Info" vs "Publication") equal-
                    width columns clipped the longer labels ("Publicatio...").
                    Correct tab identity/selected-state styling (the actual ask)
                    matters more than exact width parity, so left as auto-width.-->
                <TabControl Grid.Row="2" x:Name="EditorTabs" Height="44" Margin="16,10,16,0"
                            SelectionChanged="OnEditorTabsSelectionChanged"
                            IsVisible="{Binding HasSelection}">
                    <TabItem Header="Basic Info" />
                    <TabItem Header="Publication" />
                    <TabItem Header="Creators" />
                    <TabItem Header="Story" />
                    <TabItem Header="Extras" />
                </TabControl>

                <ScrollViewer Grid.Row="3" Padding="16,10">
                    <!--FontSize/FontFamily bound here (not wired until slice 5, when
                        the Settings dialog first made this setting visibly testable) -
                        inherits down to every field row's TextBox/TextBlock built in
                        BuildFieldTemplateSelector below, same as the winui original-->
                    <ItemsControl x:Name="FieldList" ItemsSource="{Binding VisibleFields}"
                                  FontSize="{Binding EditorFontSize}" FontFamily="{Binding EditorFontFamily}"
                                  MaxWidth="{Binding EditorFieldsMaxWidth}" HorizontalAlignment="Left" />
                </ScrollViewer>
                <TextBlock Grid.Row="3" Text="Open a comic archive to begin" Opacity="0.5" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSelection}" />
            </Grid>
        </Grid>

        <!--grid view (slice 2): dirty-indicator column is fixed/declared here like
            the winui original; the rest come from AppSettings.GridColumns, built
            in code (RebuildGridColumns). Right-click context menu (Edit/Choose
            Columns…) added in a later slice, mirroring OnGridRightTapped/
            GridContextFlyout_Opening from the winui original-->
        <DataGrid Grid.Row="2" x:Name="ComicsGrid"
                  ItemsSource="{Binding DisplayedFiles}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  IsVisible="{Binding IsGridViewActive}"
                  DoubleTapped="OnGridDoubleTapped"
                  Margin="16,10,16,16">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ComicFileViewModel">
                            <TextBlock Text="&#x2022;" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThDirtyFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IsDirty}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu Opening="GridContextMenu_Opening">
                    <MenuItem x:Name="GridEditMenuItem" Header="Edit" Click="OnGridEditSelection" />
                    <Separator />
                    <MenuItem Header="Choose Columns…" Click="OnChooseColumns" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!--status bar (slice 23): previously StatusText sat inline in the
            toolbar row; matches the winui original's dedicated full-width
            row at the bottom of the window instead-->
        <Border Grid.Row="3" Background="{DynamicResource ThBg2}"
                BorderBrush="{DynamicResource ThSep}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Margin="12,6" Opacity="0.7" />
        </Border>

        <!--drag-and-drop overlay (slice 11): shown only while a file is being
            dragged over the window; IsHitTestVisible="False" so drag events
            keep landing on RootGrid itself rather than being swallowed here-->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="4"
                Background="#B0000000" BorderBrush="DodgerBlue" BorderThickness="3"
                IsVisible="False" IsHitTestVisible="False">
            <TextBlock Text="Drop comic archives to open" FontSize="22" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>

</Window>
