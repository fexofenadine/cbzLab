<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--avalonia rewrite skeleton (step 1 of the port, see CLAUDE.md): plain
        net8.0, no windows-specific tfm suffix, targeting windows + linux
        desktop from one build-->
    <!--WinExe, not Exe: plain Exe allocates a console window on Windows (the
        blank/black window that stayed open behind the GUI for the whole
        session), matching a real bug rather than a testing artifact - the
        winui original's own csproj already uses WinExe for the same reason.
        WinExe is a Windows PE-subsystem concept with no meaning on Linux, so
        this stays a no-op there rather than breaking cross-platform builds.-->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>cbzLab.Avalonia</RootNamespace>
    <AssemblyName>cbzLab.Avalonia</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--2.0.0 Beta 1.0: first tracked beta of the avalonia port. Bump the beta
        number (1.0 -> 1.1, 2.0, ...) after each significant improvement pass;
        stays 2.0.0-beta until parity with the winui original is reached, at
        which point this becomes the real 2.0.0 and the winui project retires.
        AssemblyVersion/FileVersion must be strictly numeric (no "beta" text
        allowed there) - MainWindow.axaml.cs's DisplayVersion constant carries
        the human-readable "2.0.0 Beta 1.0" string shown in the title bar/About.-->
    <Version>2.0.0-beta1.1</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <!--scoped to Release only, not the main PropertyGroup above: SelfContained
      (and RID-specific output it implies) applies to plain `dotnet build`
      too, not just `dotnet publish`, if left unconditional - confirmed the
      hard way when a debug build silently started producing bin/Debug/
      net8.0/win-x64/ (a full self-contained framework copy) instead of the
      normal bin/Debug/net8.0/ single-dll output, and a stale pre-existing
      exe at the old path kept getting tested instead of the real new build.
      Every publish command actually used for this project passes -c Release
      (see CLAUDE.md), so gating on Configuration keeps `dotnet build`'s
      default Debug config fast and framework-dependent while Release
      publishes still get the single-file bundle below.-->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!--matches cbzLab.csproj's own publish settings, so `dotnet publish -c
        Release` needs no extra flags on the command line either - the winui
        original already carries the same reasoning in its own (longer)
        comment on these same three properties. IncludeNativeLibrariesForSelfExtract
        bundles Avalonia's native deps (Skia/HarfBuzz/ANGLE) into the single
        exe instead of leaving them as loose DLLs beside it.-->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!--Avalonia.Diagnostics (dev-time f12 inspector) skipped for now: as of
        this writing it has no 12.x release yet (latest is 11.3.20, against
        core packages at 12.1.1) - add back once a compatible version ships-->
    <!--matches the version pinned in cbzLab.csproj; needed by the ported
        ArchiveService.cs for cbr (rar) reading-->
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <!--grid view (slice 2): one patch ahead of the 12.1.1 core packages above -
        same avaloniaui-owned package family, no lower version published-->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!--ported schema.json/themes.json/theme files, same seeding pattern as
        cbzLab.csproj - see Services/SettingsService.cs SeedBundledAssets()-->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--SkiaSharp/HarfBuzzSharp ship their native .pdb files as content-copied
      publish outputs (~105MB combined) alongside their .dll - the .dll
      itself is a "native library" IncludeNativeLibrariesForSelfExtract
      already bundles into the exe above, but its .pdb isn't covered by
      that flag and would otherwise stay loose. cbzLab.Avalonia.pdb (this
      project's own, small) is left alone - matches the winui original,
      which ships exactly one pdb for the same debugging reason.-->
  <Target Name="RemoveThirdPartyNativePdbsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                              Condition="'%(Filename)' == 'libSkiaSharp' or '%(Filename)' == 'libHarfBuzzSharp'" />
    </ItemGroup>
  </Target>

</Project>
